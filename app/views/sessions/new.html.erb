<% content_for :heading, "Sign in to track your search" %>

<%= form_with url: session_path, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email", class: AuthHelper::AUTH_LABEL %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          placeholder: "you@example.com", value: params[:email_address], class: AuthHelper::AUTH_INPUT %>
  </div>
  <div>
    <div class="flex items-baseline justify-between">
      <%= form.label :password, "Password", class: AuthHelper::AUTH_LABEL %>
      <%= link_to "Forgot password?", new_password_path, class: "text-sm #{AuthHelper::AUTH_LINK}" %>
    </div>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: AuthHelper::AUTH_INPUT %>
  </div>
  <%= form.submit "Sign in", class: AuthHelper::AUTH_BUTTON %>
<% end %>
