<% content_for :title, "New password" %>
<% content_for :heading, "Choose a new password" %>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :password, "New password", class: AuthHelper::AUTH_LABEL %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: AuthHelper::AUTH_INPUT %>
  </div>
  <div>
    <%= form.label :password_confirmation, "Repeat new password", class: AuthHelper::AUTH_LABEL %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: AuthHelper::AUTH_INPUT %>
  </div>
  <%= form.submit "Save password", class: AuthHelper::AUTH_BUTTON %>
<% end %>
